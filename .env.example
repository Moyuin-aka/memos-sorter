# .env.example

# Memos Configuration
# 你的 Memos 服务 URL
MEMOS_URL="https://demo.usememos.com"

# 你的 Memos Open API 密钥 (在 设置 -> 我的账户 中找到)
MEMOS_API_TOKEN="your_memos_api_token_here"

# --- AI Model Configuration ---
# 请根据你选择的 LLM 服务，取消注释并填写对应的 API 密钥。
# 将你选择使用的模型的 API Key 环境变量名，填入 config.py 的 LLM_API_KEY_NAME 变量中。

# Google Gemini API Key
GEMINI_API_KEY="your_gemini_api_key_here"

# OpenAI API Key
# OPENAI_API_KEY="your_openai_api_key_here"

# Anthropic Claude API Key
# ANTHROPIC_API_KEY="your_anthropic_api_key_here"

# Gemini Model Name (Optional)
# 默认使用 'gemini-1.5-flash-latest'. 您可以从可用模型列表中选择其他模型。
# GEMINI_MODEL_NAME="gemini-1.5-pro-latest"
