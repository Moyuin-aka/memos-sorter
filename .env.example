# .env.example

# Memos Configuration
# Your Memos server URL
MEMOS_URL="MEMOS_URL"

# Your Memos Open API (found in setting -> MyAccount )
MEMOS_API_TOKEN="MEMOS_API_TOKEN"

# --- AI Model Configuration ---
# 至少配置以下其中一个 LLM Provider 的 API Key

# Google Gemini API Key
# GEMINI_API_KEY="your_gemini_api_key_here"

# Gemini Model Name (Optional, default: gemini-1.5-flash-latest)
# GEMINI_MODEL_NAME="gemini-2.5-flash-lite"

# OpenRouter API Key (https://openrouter.ai)
OPENROUTER_API_KEY="your_openrouter_api_key_here"

# OpenRouter Model Name (Optional, default: google/gemini-2.0-flash-exp:free)
# 查看可用模型: https://openrouter.ai/models
OPENROUTER_MODEL_NAME="google/gemini-2.0-flash-exp:free"

# OpenRouter Site Information (Optional, for rankings on openrouter.ai)
# OPENROUTER_SITE_URL="https://yourdomain.com"
# OPENROUTER_SITE_NAME="Memos Sorter"
